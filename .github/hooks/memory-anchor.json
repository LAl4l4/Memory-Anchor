{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "memoryanchor-pre",
        "powershell": "memoryanchor-pre",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "memoryanchor-copilot-pre",
        "powershell": "memoryanchor-copilot-pre",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "memoryanchor-past",
        "powershell": "memoryanchor-past",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "memoryanchor-post",
        "powershell": "memoryanchor-post",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "memoryanchor-copilot-post",
        "powershell": "memoryanchor-copilot-post",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "memoryanchor-copilot-stop",
        "powershell": "memoryanchor-copilot-stop",
        "timeoutSec": 10
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": "memoryanchor-copilot-prompt",
        "powershell": "memoryanchor-copilot-prompt",
        "timeoutSec": 5
      }
    ]
  }
}
