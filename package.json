{
  "name": "memory-anchor",
  "version": "1.6.1",
  "description": "MemoryAnchor CLI scaffold",
  "license": "Apache-2.0",
  "author": "LAl4l4",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "anchor": "dist/cli.js",
    "memoryanchor-copilot-pre": "dist/hooks/copilot/pre-session.js",
    "memoryanchor-copilot-post": "dist/hooks/copilot/post-session.js",
    "memoryanchor-copilot-stop": "dist/hooks/copilot/agent-stop.js",
    "memoryanchor-claude-pre": "dist/hooks/claude/session-start.js",
    "memoryanchor-claude-post": "dist/hooks/claude/session-end.js",
    "memoryanchor-claude-prompt": "dist/hooks/claude/user-prompt.js",
    "memoryanchor-claude-stop": "dist/hooks/claude/stop.js",
    "memoryanchor-codex-pre": "dist/hooks/codex/session-start.js",
    "memoryanchor-codex-prompt": "dist/hooks/codex/user-prompt.js",
    "memoryanchor-codex-stop": "dist/hooks/codex/stop.js",
    "memoryanchor-codebuddy-pre": "dist/hooks/codebuddy/session-start.js",
    "memoryanchor-codebuddy-post": "dist/hooks/codebuddy/session-end.js",
    "memoryanchor-codebuddy-prompt": "dist/hooks/codebuddy/user-prompt.js",
    "memoryanchor-codebuddy-stop": "dist/hooks/codebuddy/stop.js",
    "memoryanchor-qodercn-pre": "dist/hooks/qodercn/session-start.js",
    "memoryanchor-qodercn-post": "dist/hooks/qodercn/session-end.js",
    "memoryanchor-qodercn-prompt": "dist/hooks/qodercn/user-prompt.js",
    "memoryanchor-copilot-prompt": "dist/hooks/copilot/user-prompt.js",
    "memoryanchor-qodercn-stop": "dist/hooks/qodercn/stop.js",
    "memoryanchor-opencode-post": "dist/hooks/opencode/session-end.js",
    "memoryanchor-opencode-stop": "dist/hooks/opencode/stop.js",
    "memoryanchor-hermes-pre": "dist/hooks/hermes/pre-llm-call.js",
    "memoryanchor-hermes-prompt": "dist/hooks/hermes/user-prompt.js",
    "memoryanchor-hermes-stop": "dist/hooks/hermes/stop.js",
    "memoryanchor-hermes-post": "dist/hooks/hermes/session-end.js"
  },
  "files": [
    "dist/",
    "tree-sitter-parser/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test:types": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run test:types && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "glob": "^13.0.6",
    "web-tree-sitter": "0.26.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.12",
    "jest": "^29.7.0",
    "tree-sitter-wasms": "^0.1.13",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.5"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "."
  }
}
